# =====================================
# APPLICATION CONFIGURATION
# =====================================

APP_NAME=SubscriptIQ
APP_ENV=development
DEBUG=True


# =====================================
# NEON POSTGRESQL DATABASE
# =====================================

DATABASE_URL=postgresql://username:password@your-neon-pooler-host/neondb?sslmode=require


# =====================================
# AUTHENTICATION
# =====================================

SECRET_KEY=replace_with_a_secure_random_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60


# =====================================
# AI CONFIGURATION
# =====================================

AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-2.5-flash
AI_BASE_URL=
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=2048
AI_TIMEOUT_SECONDS=30
AI_TURN_TIMEOUT_SECONDS=50
# Backward-compatible provider-specific keys/models are also supported.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini


# =====================================
# FRONTEND CONFIGURATION
# =====================================

FRONTEND_URL=http://localhost:5173


# =====================================
# OPTIONAL EMAIL DELIVERY
# =====================================

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_STARTTLS=True

# =============================================================================
# ACCOUNT ONBOARDING
# =============================================================================
# Invites, password resets and email confirmation need SMTP above.
#   Development: a test inbox such as Mailtrap (catches every email, nothing reaches real people)
#     SMTP_HOST=sandbox.smtp.mailtrap.io  SMTP_PORT=587  SMTP_USERNAME/PASSWORD from your Mailtrap inbox
#   Demo / production: Gmail with an app password (smtp.gmail.com:587), Brevo or SendGrid.
# FRONTEND_URL must point at the frontend — email links open there.

# Customers must click a confirmation link before logging in (keep false until SMTP works).
REQUIRE_EMAIL_VERIFICATION=false
# How long invite and confirmation links stay valid (password reset links: 30 minutes).
INVITE_LINK_TTL_HOURS=48
