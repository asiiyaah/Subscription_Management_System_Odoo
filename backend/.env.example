# =====================================
# APPLICATION CONFIGURATION
# =====================================

APP_NAME=SubscriptIQ
APP_ENV=development
DEBUG=True


# =====================================
# NEON POSTGRESQL DATABASE
# =====================================

DATABASE_URL=postgresql://username:password@your-neon-pooler-host/neondb?sslmode=require


# =====================================
# AUTHENTICATION
# =====================================

SECRET_KEY=replace_with_a_secure_random_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60


# =====================================
# AI CONFIGURATION
# =====================================

AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-2.5-flash
AI_BASE_URL=
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=2048
AI_TIMEOUT_SECONDS=30
AI_TURN_TIMEOUT_SECONDS=50
# Backward-compatible provider-specific keys/models are also supported.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini


# =====================================
# FRONTEND CONFIGURATION
# =====================================

FRONTEND_URL=http://localhost:5173


# =====================================
# OPTIONAL EMAIL DELIVERY
# =====================================

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_STARTTLS=True
