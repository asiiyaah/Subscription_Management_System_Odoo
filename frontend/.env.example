# Backend base URL (FastAPI)
VITE_API_URL=http://localhost:8000
# true = use local mock data instead of the backend
VITE_USE_MOCKS=true
# Member 2 modules to run against the real backend while the rest stays on mocks.
# All of Member 2's modules (auth + account switch on automatically):
#   VITE_LIVE_APIS=taxes,discounts,users,settings,lookups,invoices,payments,reports,portal,ai
VITE_LIVE_APIS=
# Demo accounts listed on the login page — emails only, passwords are never shown (type them yourself).
# Format Role:email, comma-separated. Use "off" to hide the panel (real launch). Unset = mock accounts in dev only.
VITE_DEMO_ACCOUNTS=Admin:admin@subscriptiq.com,Staff:staff@subscriptiq.com,Customer:customer@acmeretail.in
