# Backend base URL (FastAPI)
VITE_API_URL=http://localhost:8000
# true = use local mock data instead of the backend
VITE_USE_MOCKS=true
# Member 2 modules to run against the real backend while the rest stays on mocks.
# Available: taxes,discounts,users,settings,lookups (auth + account switch on automatically).
VITE_LIVE_APIS=
